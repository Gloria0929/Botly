# 复制为 .env 后按需修改。已存在的环境变量优先于本文件。
BOTLY_SECRET_KEY=dev-insecure-secret-key-please-change
# BOTLY_ENV=production              # 上线时开启密钥校验，认证链接必须配置 BOTLY_BASE_URL
# BOTLY_ENCRYPTION_KEY=...           # 独立 Fernet 密钥；不要在已有部署中随意更换

# Redis：本机 Docker 中的 redis 容器（带 requirepass）；替换成长随机密码
BOTLY_REDIS_URL=redis://:CHANGE_ME_use_a_long_random_password@127.0.0.1:6379/0

# 数据目录与数据库
# BOTLY_DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://botly:botly@127.0.0.1:5432/botly

# 部署在 HTTPS 反向代理后时设为 1，强制会话 Cookie 带 Secure
# BOTLY_COOKIE_SECURE=1

# ---- 邮件：审批提醒、找回密码、邮箱验证 ----
# 不配 SMTP 也能跑：MAIL_DEV=1 时邮件内容写进日志，接口会回一个可直接打开的链接。
# 上线前必须配好 SMTP 并把 BOTLY_MAIL_DEV 设为 0，否则没人能真的收到邮件。
# BOTLY_SMTP_HOST=smtp.example.com
# BOTLY_SMTP_PORT=587
# BOTLY_SMTP_SECURITY=starttls       # starttls（587）/ ssl（465）/ none（内网中继）
# BOTLY_SMTP_USER=no-reply@example.com
# BOTLY_SMTP_PASSWORD=xxxxxxxx
# BOTLY_MAIL_FROM=no-reply@example.com
# BOTLY_MAIL_DEV=1                   # 生产设为 0

# 审批与认证邮件在非开发环境必须使用明确配置的站点地址。
# BOTLY_BASE_URL=https://botly.example.com
# BOTLY_RESET_TOKEN_TTL_MINUTES=60
# BOTLY_VERIFY_TOKEN_TTL_HOURS=24

# ---- 第三方登录（Google / GitHub）----
# 在各自后台建 OAuth 应用，回调地址填 {域名}/api/auth/oauth/google/callback
# （GitHub 同理换成 github）。client id/secret 没配全时，登录页不会出现对应按钮。
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
# BOTLY_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# BOTLY_GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# BOTLY_GITHUB_CLIENT_ID=Ov23liXXXX
# BOTLY_GITHUB_CLIENT_SECRET=xxxx
# 回调地址前缀：对外域名与后端推导出来的不一致时才需要配（必须和后台登记的一致）
# BOTLY_OAUTH_REDIRECT_BASE=https://botly.example.com
# 陌生账号能否直接用它登录建号：1 允许（默认），0 只允许已注册用户绑定登录
# BOTLY_OAUTH_ALLOW_SIGNUP=0

# 日志：写入 data/logs/app.log 并同时输出控制台
# BOTLY_LOG_LEVEL=INFO          # DEBUG 会连 2xx 请求也逐条记录
# BOTLY_LOG_BODY=0              # 设为 0 不记录查询参数与请求体（默认 1，敏感字段已脱敏）
# BOTLY_LOG_FILE_MAX_MB=20      # 单个日志文件上限，超出后轮转

# ---- 沙箱接入：默认保留入口，不启动本机容器 ----
# none = 尚未接入；docker = 本机 Docker，仅测试；external = 服务端云沙箱适配器。
# BOTLY_SANDBOX_PROVIDER=none
# BOTLY_SANDBOX_ADAPTER=your_package.cube:CubeBackend
# CubeSandbox 官方 Python SDK 使用 CUBE_API_URL / CUBE_TEMPLATE_ID / CUBE_PROXY_NODE_IP。
# 接入约定与文件同步要求见 docs/沙箱接入.md。
# BOTLY_ADMIN_EMAILS=admin@example.com    # 可查看部署日志和系统告警的账号，逗号分隔
# BOTLY_MCP_STDIO_ENABLED=0              # 默认禁用；启用后也仅管理员可配置和状态
# BOTLY_MCP_STDIO_ALLOWED_COMMANDS=[["/usr/local/bin/node","/opt/mcp/server.js"]]
# BOTLY_ALLOW_PRIVATE_BASE_URL=0         # 默认拒绝模型服务的内网地址；仅可信自建部署开启
# BOTLY_WORKER_CONCURRENCY=20
# BOTLY_MAX_CONCURRENT_RUNS=20
# BOTLY_MAX_CONCURRENT_RUNS_PER_USER=2
# BOTLY_REDIS_PREFIX=botly                # 不同部署/测试库使用不同队列前缀

# ---- Docker 本地测试后端：仅在 BOTLY_SANDBOX_PROVIDER=docker 时生效 ----
# run_command（shell 命令，L3 审批）与 code_exec（跑代码，默认 L2）共用这一个容器，
# 工作区挂到 data/sandbox/{user}/{chat}，与文件工具是同一份文件。
# 预装镜像：./scripts/build_sandbox.sh 构建 botly-sandbox:24.04（python3/node/git/jq 等已装好），
# 镜像不存在时自动退回 ubuntu:24.04，只是 python/node 首次用到时才 apt 装。
# BOTLY_LINUX_SANDBOX_ENABLED=1
# BOTLY_LINUX_SANDBOX_IMAGE=botly-sandbox:24.04
# BOTLY_LINUX_SANDBOX_BASELINE_IMAGE=ubuntu:24.04   # 预装镜像缺失时的兜底
# BOTLY_LINUX_SANDBOX_TIMEOUT=60          # 单条命令的超时（容器内 timeout 兜底）
# BOTLY_LINUX_SANDBOX_MEMORY=1g
# BOTLY_LINUX_SANDBOX_CPUS=1.0
# BOTLY_LINUX_SANDBOX_AUTO_INSTALL=1      # 缺 python3/node 时自动 apt 装（首次会慢）
# BOTLY_CODE_SANDBOX_TIMEOUT=30           # 单段代码的超时
# BOTLY_CODE_EXEC_LEVEL=L2                # 想和 run_command 一样默认审批就改 L3，可按群聊始终允许
